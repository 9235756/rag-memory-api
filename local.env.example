# ===== Режим работы =====
# auto  — реальные сервисы, если ключи заданы, иначе эмуляция
# true  — всегда эмуляция (оффлайн)
# false — только реальные сервисы (ошибка, если ключей нет)
MOCK_MODE=auto

# ===== OpenAI (LLM + эмбеддинги) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ===== Pinecone =====
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE_KB=knowledge
PINECONE_NAMESPACE_MEMORY=user-memory

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=

# ===== Внешний API =====
CAT_FACT_API_URL=https://catfact.ninja/fact
HTTP_TIMEOUT=10

# ===== Чанкинг / поиск =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
SCORE_THRESHOLD=0.3
